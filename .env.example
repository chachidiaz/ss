# ---- Required for the automatic webhook (/api/ingest) ----

# Any long random string. The Zap sends it so strangers can't post to your archive.
# Generate one with:  openssl rand -hex 32
ARCHIVE_INGEST_SECRET=

# A GitHub fine-grained token with Contents: Read and write on this repo only.
GITHUB_TOKEN=
GITHUB_REPO=chachidiaz/ss
GITHUB_BRANCH=main

# ---- Public site settings ----

# Your live URL. Used for RSS, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://sixfigureinsider.vercel.app

# Your Flodesk signup form's share link. The Subscribe buttons stay hidden
# until this is set.
NEXT_PUBLIC_SIGNUP_URL=
